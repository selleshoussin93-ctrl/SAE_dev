<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="universite_paris8.iut.jbouguerba.sae_jeux.controller.ControllerDefaite"
      alignment="CENTER"
      spacing="40"
      style="-fx-background-color: #1a6fa8;"
      prefWidth="800" prefHeight="651">

    <Label text="GAME OVER"
           style="-fx-font-size: 80px;
                  -fx-font-weight: bold;
                  -fx-text-fill: black;
                  -fx-border-color: red;
                  -fx-border-width: 4px;
                  -fx-padding: 10 20 10 20;"/>

    <Button text="Rejouer"
            fx:id="boutonRejouer"
            onAction="#rejouer"
            style="-fx-font-size: 24px;
                   -fx-background-color: red;
                   -fx-text-fill: white;
                   -fx-padding: 10 30 10 30;"/>

</VBox>